# Skopiuj do .env i uzupełnij wartości. Plik .env jest ignorowany przez git.

# Formularz kontaktowy / wysyłka maili (Gmail SMTP)
GMAIL_EMAIL=
GMAIL_PASSWORD=
# Adres, na który trafiają leady z formularza i asystenta AI
OWNER_EMAIL=

# Asystent AI (OpenAI) - klucz tylko po stronie serwera
OPENAI_API_KEY=
# Model do rozmowy (domyślnie gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Model do podsumowania rozmowy przed wysyłką (domyślnie = OPENAI_MODEL)
OPENAI_SUMMARY_MODEL=
# Ustaw "false", aby tymczasowo wyłączyć asystenta bez usuwania klucza
AI_ASSISTANT_ENABLED=true
# Ustaw "true", aby klient dostawał kopię rozmowy na swój e-mail
AI_SEND_CLIENT_COPY=false

# Supabase (rezerwacje spotkań)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar (rezerwacje spotkań)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Opinie Google
GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=
